# Copiar a .env en esta carpeta. Autenticación integrada Windows; sin usuarios ni claves.
# Rutas relativas del Excel: respecto a 02_ETL_Python, incluso al ejecutar desde otra carpeta.
RETAIL_EXCEL=../01_Base_de_Datos/online_retail_II.xlsx
RETAIL_SERVER=localhost
RETAIL_DATABASE=OnlineRetail_Origen_Replica
RETAIL_BATCH_SIZE=5000
# Vacío = preferir ODBC Driver 18, después 17.
RETAIL_ODBC_DRIVER=
# Valor yes: acepta el certificado local. Valor no: exige certificado confiable.
RETAIL_TRUST_CERTIFICATE=yes
