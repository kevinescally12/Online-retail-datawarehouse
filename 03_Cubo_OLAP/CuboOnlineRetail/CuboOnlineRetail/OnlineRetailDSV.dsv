        </xs:keyref>
        <xs:keyref name="FK_Fact_DimPais" refer="dbo_DimPais_Constraint1">
          <xs:selector xpath=".//dbo_FactOperacion" />
          <xs:field xpath="PaisKey" />
        </xs:keyref>
        <xs:keyref name="FK_Fact_DimCliente" refer="dbo_DimCliente_Constraint1">
          <xs:selector xpath=".//dbo_FactOperacion" />
          <xs:field xpath="ClienteKey" />
        </xs:keyref>
        <xs:keyref name="FK_Fact_DimProducto" refer="dbo_DimProducto_Constraint1">
          <xs:selector xpath=".//dbo_FactOperacion" />
          <xs:field xpath="ProductoKey" />
        </xs:keyref>
        <xs:keyref name="FK_Fact_DimFecha" refer="Constraint1">
          <xs:selector xpath=".//dbo_FactOperacion" />
          <xs:field xpath="FechaKey" />
        </xs:keyref>
      </xs:element>
    </xs:schema>
    <OnlineRetailDSV xmlns="" />
  </Schema>
