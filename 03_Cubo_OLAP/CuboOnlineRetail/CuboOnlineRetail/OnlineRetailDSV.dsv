        </xs:unique>
        <xs:unique name="dbo_DimTipoOperacion_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimTipoOperacion" />
          <xs:field xpath="TipoOperacionKey" />
        </xs:unique>
        <xs:unique name="dbo_FactOperacion_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_FactOperacion" />
